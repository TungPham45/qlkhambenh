{
  "name": "qlphongkham-microservices",
  "version": "2.0.0",
  "description": "Clinic Management System with React, NestJS Microservices, PostgreSQL and Redis",
  "scripts": {
    "start": "docker-compose up -d",
    "start:build": "docker-compose up -d --build",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "logs": "docker-compose logs -f",
    "logs:api": "docker-compose logs -f api-gateway",
    "ps": "docker-compose ps",
    "clean": "docker-compose down -v",
    "install:all": "npm --prefix backend-nestjs install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend-nestjs run start:dev api-gateway",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "keywords": [
    "nestjs",
    "react",
    "microservices",
    "redis",
    "postgresql",
    "typeorm",
    "docker"
  ],
  "author": "Clinic Team",
  "license": "ISC"
}
