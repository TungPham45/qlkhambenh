{
  "name": "clinic-management-backend",
  "version": "1.0.0",
  "description": "Clinic Management System Backend - NestJS Microservices with Redis & PostgreSQL",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api-gateway && nest build auth-service && nest build patient-service && nest build staff-service && nest build appointment-service && nest build medical-record-service && nest build pharmacy-service && nest build billing-service && nest build analytics-service && nest build statistical-service",
    "start": "nest start",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:patient": "nest start patient-service --watch",
    "start:dev:staff": "nest start staff-service --watch",
    "start:dev:appointment": "nest start appointment-service --watch",
    "start:dev:medical-record": "nest start medical-record-service --watch",
    "start:dev:pharmacy": "nest start pharmacy-service --watch",
    "start:dev:billing": "nest start billing-service --watch",
    "start:dev:analytics": "nest start analytics-service --watch",
    "start:dev:statistical": "nest start statistical-service --watch",
    "start:prod:api-gateway": "node dist/apps/api-gateway/apps/api-gateway/src/main.js",
    "start:prod:auth-service": "node dist/apps/auth-service/apps/auth-service/src/main.js",
    "start:prod:patient-service": "node dist/apps/patient-service/apps/patient-service/src/main.js",
    "start:prod:staff-service": "node dist/apps/staff-service/apps/staff-service/src/main.js",
    "start:prod:appointment-service": "node dist/apps/appointment-service/apps/appointment-service/src/main.js",
    "start:prod:medical-record-service": "node dist/apps/medical-record-service/apps/medical-record-service/src/main.js",
    "start:prod:pharmacy-service": "node dist/apps/pharmacy-service/apps/pharmacy-service/src/main.js",
    "start:prod:billing-service": "node dist/apps/billing-service/apps/billing-service/src/main.js",
    "start:prod:analytics-service": "node dist/apps/analytics-service/apps/analytics-service/src/main.js",
    "start:prod:statistical-service": "node dist/apps/statistical-service/apps/statistical-service/src/main.js",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.8",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
