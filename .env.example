# ==================== DATABASE ====================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# Individual Service Databases
DB_AUTH=db_auth
DB_PATIENT=db_patient
DB_APPOINTMENT=db_appointment
DB_MEDICAL_RECORD=db_medical_record
DB_BILLING=db_billing
DB_ACCOUNT=db_account
DB_ANALYTICS=db_analytics
DB_STATISTICS=db_statistics

# ==================== SERVICES ====================

# Auth Service
AUTH_SERVICE_URL=http://auth_service:8001
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

# Patient Service
PATIENT_SERVICE_URL=http://patient_service:8002
PATIENT_DB_USER=patient_user
PATIENT_DB_PASSWORD=patient_pass

# Appointment Service
APPOINTMENT_SERVICE_URL=http://appointment_service:8003
APPOINTMENT_DB_USER=appointment_user
APPOINTMENT_DB_PASSWORD=appointment_pass

# Medical Record Service
MEDICAL_RECORD_SERVICE_URL=http://medical_record_service:8004
MEDICAL_RECORD_DB_USER=medical_record_user
MEDICAL_RECORD_DB_PASSWORD=medical_record_pass

# Billing Service
BILLING_SERVICE_URL=http://billing_service:8005
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_pass

# Account Service
ACCOUNT_SERVICE_URL=http://account_service:8006
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASSWORD=account_pass

# Pharmacy Service
PHARMACY_SERVICE_URL=http://pharmacy_service:8007
PHARMACY_DB_USER=pharmacy_user
PHARMACY_DB_PASSWORD=pharmacy_pass

# Analytics Service
ANALYTICS_SERVICE_URL=http://analytics_service:8008
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_pass
ANALYTICS_CACHE_TTL=300

# Statistical Service
STATISTICAL_SERVICE_URL=http://statistical_service:8009
STATISTICS_DB_USER=statistics_user
STATISTICS_DB_PASSWORD=statistics_pass
STATISTICS_CACHE_TTL=600

# ==================== GATEWAY ====================

GATEWAY_PORT=80

# ==================== JWT ====================

JWT_SECRET=your-secret-key-change-in-production-environment
JWT_EXPIRATION=3600

# ==================== REDIS ====================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== RATE LIMITING ====================

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ==================== CORS ====================

ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# ==================== LOGGING ====================

LOG_LEVEL=info
LOG_CHANNEL=daily

# ==================== ENVIRONMENT ====================

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# ==================== EMAIL (Optional) ====================

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@clinicmanagement.local
MAIL_FROM_NAME="Clinic Management"

# ==================== MESSAGE BROKER ====================

BROKER_TYPE=redis
BROKER_REDIS_HOST=redis
BROKER_REDIS_PORT=6379

# Hoặc sử dụng RabbitMQ
# BROKER_TYPE=rabbitmq
# BROKER_RABBITMQ_HOST=rabbitmq
# BROKER_RABBITMQ_PORT=5672
# BROKER_RABBITMQ_USER=guest
# BROKER_RABBITMQ_PASSWORD=guest
